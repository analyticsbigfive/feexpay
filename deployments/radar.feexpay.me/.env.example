# radar.feexpay.me — copier en .env sur le serveur, jamais commité.
# Mêmes noms que le .env.example racine : docker-entrypoint.sh les relaie à Nuxt.

# Supabase
SUPABASE_URL=
SUPABASE_KEY=                 # clé anon
SUPABASE_SERVICE_KEY=         # clé service_role
# Pooler Supavisor en mode session, port 5432 (jamais 6543). La connexion directe de
# Supabase est en IPv6 seulement : le pooler marche que le VPS ait l'IPv6 ou non.
DATABASE_URL=
# true au premier démarrage seulement si les migrations ont déjà été jouées à la main sur
# cette base. Sans effet une fois la table radar_migration remplie.
MIGRATIONS_BASELINE=false

# Email : expéditeur sur le domaine vérifié chez Resend (docs/DNS_radar.feexpay.me.md).
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM=Radar by FeexPay <radar@radar.feexpay.me>

# Tâches planifiées (cron.sh)
CRON_SECRET=

# Liens des emails : invitations admin, réinitialisation, rapports, suppression de données.
APP_BASE_URL=https://radar.feexpay.me

# Les identifiants GA4, Pixel et CAPI sont en base (écran Réglages).
TRACKING_ENABLED=true
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_META_PIXEL_ID=
